{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-guid>",
    "ClientId": "<app-registration-client-id>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "Board": {
    "EditorGroupId": "<entra-group-object-id>",
    "Display": {
      "AllowedIps": [ "203.0.113.10" ],
      "KeyHash": "",
      "PollSeconds": 10
    },
    "MaxNoteLength": 280,
    "MaxNotes": 12
  },

  "ConnectionStrings": {
    "Board": "Data Source=/data/noticeboard.db"
  },

  "ForwardedHeaders": {
    "KnownProxies": [ "10.0.0.5" ]
  },

  "AllowedHosts": "board.yourdomain.com",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}