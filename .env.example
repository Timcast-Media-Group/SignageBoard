# SignageBoard server configuration.
# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# "__" separates config sections; trailing __0, __1 ... are array indexes.
# See README.md -> "Configure the server" for what each value means for your server and Pi.

ASPNETCORE_ENVIRONMENT=Production

# Host name(s) editors and the Raspberry Pi use to reach the board, ";"-separated.
AllowedHosts=board.example.com

# Microsoft Entra ID app registration (editor sign-in). No client secret is used.
AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=00000000-0000-0000-0000-000000000000
AzureAd__ClientId=00000000-0000-0000-0000-000000000000
AzureAd__CallbackPath=/signin-oidc
AzureAd__SignedOutCallbackPath=/signout-callback-oidc

# Object ID of the Entra security group whose members may edit the board.
Board__EditorGroupId=00000000-0000-0000-0000-000000000000

# Display (Raspberry Pi) access. The Pi holds the key; the server only stores its hash.
Board__Display__KeyHash=REPLACE_WITH_UPPERCASE_HEX_SHA256_OF_DISPLAY_KEY
# The Pi's address as the server sees it: its LAN IP if the server is on the same
# network, otherwise the public IP of the Pi's network. Add __1, __2 for more displays.
Board__Display__AllowedIps__0=203.0.113.10
Board__Display__PollSeconds=10

Board__MaxNoteLength=280
Board__MaxNotes=12

# Keep both under /data so they live on the Docker volume.
ConnectionStrings__Board=Data Source=/data/noticeboard.db
DataProtection__KeysPath=/data/keys

# The reverse proxy's address as seen from inside the container (Docker's bridge gateway).
ForwardedHeaders__KnownProxies__0=172.17.0.1
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
